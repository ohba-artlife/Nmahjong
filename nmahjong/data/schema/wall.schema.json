{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://nmahjong.dev/schema/wall.schema.json",
 "title": "Nmahjong wall 1.0",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "format": {
   "const": "nmahjong-wall"
  },
  "version": {
   "const": "1.0"
  },
  "id": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$"
  },
  "tileset": {
   "type": "object",
   "required": [
    "id"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "id": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    }
   }
  },
  "source": {
   "enum": [
    "generated",
    "observed",
    "filled"
   ]
  },
  "generation": {
   "type": "object",
   "required": [
    "method",
    "seed"
   ],
   "properties": {
    "method": {
     "type": "string"
    },
    "seed": {
     "type": "string"
    },
    "round": {
     "type": "integer",
     "minimum": 0
    },
    "oya": {
     "type": "integer",
     "minimum": 0
    },
    "players": {
     "type": "integer",
     "minimum": 1
    },
    "hand": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "observed": {
   "type": "array",
   "items": {
    "type": "array",
    "items": {
     "type": "integer",
     "minimum": 0
    },
    "minItems": 2,
    "maxItems": 2
   }
  },
  "fill": {
   "type": "object",
   "required": [
    "method",
    "seed"
   ],
   "properties": {
    "method": {
     "type": "string"
    },
    "seed": {
     "type": "string"
    }
   }
  },
  "device": {
   "type": "object",
   "required": [
    "id"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "maker": {
     "type": "string"
    },
    "model": {
     "type": "string"
    },
    "firmware": {
     "type": "string"
    },
    "at": {
     "type": "string"
    }
   }
  },
  "order": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "integer",
    "minimum": 0
   },
   "uniqueItems": true
  },
  "meta": {
   "type": "object"
  }
 },
 "required": [
  "format",
  "version",
  "tileset",
  "source",
  "order",
  "id"
 ]
}
